DATABASE_URL=postgresql+asyncpg://weathergpt:changeme@postgres:5432/weathergpt
POSTGRES_USER=weathergpt
POSTGRES_PASSWORD=changeme
REDIS_URL=redis://redis:6379
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
OPENWEATHERMAP_API_KEY=...
IMD_API_KEY=
API_KEYS=test-key
WHISPER_MODEL_SIZE=base
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
GRAFANA_PASSWORD=admin
# WIS2.0 / MQTT
WIS2_ENABLED=false
WIS2_BROKER_HOST=globalbroker.meteo.fr
WIS2_BROKER_PORT=8883
# GIS
NOMINATIM_USER_AGENT=weathergpt-sih2026
# Local LLM (Ollama + Qwen 2.5 7B) — set true only when Ollama runs locally.
# Leave false on Railway; NVIDIA NIM is used instead.
LOCAL_LLM_ENABLED=false
LOCAL_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_HOST=localhost

# ── SMS / WhatsApp (Twilio) ──
# Free sandbox: https://console.twilio.com/us1/develop/sms/try-it-out/whatsapp-learn
# For SMS testing: just set TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN + TWILIO_PHONE_NUMBER
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+14155992671          # Your Twilio trial SMS number
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886  # Sandbox (no change needed for testing)

# ── TTS ──
# No API key needed — gTTS uses Google Translate TTS endpoint (free, rate-limited)
# Disable by not installing gTTS: pip uninstall gTTS

# ── Web Push (VAPID) ──
# Generate keys: python3 -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print(v.private_pem().decode())"
VAPID_PRIVATE_KEY=your_vapid_private_key_pem
VAPID_PUBLIC_KEY=your_vapid_public_key_base64url   # also set in frontend VITE_VAPID_PUBLIC_KEY
VAPID_CLAIMS_EMAIL=mailto:team@sanket.in

# ── Feedback digest (SMTP) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_gmail_app_password   # Gmail → Settings → App Passwords
FEEDBACK_DIGEST_EMAIL=team@sanket.in    # Where the weekly digest goes
